# OpenAI Configuration (for embeddings)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# Supabase Configuration (for database and vector storage)
SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Vector backend: supabase (default, cloud) or local (FastEmbed + SQLite, offline)
VECTOR_BACKEND=supabase
# Local backend options (used only when VECTOR_BACKEND=local)
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
LOCAL_VECTOR_DB_PATH=./data/local_vectors.db