[MAIN]
# Python code to execute, usually for sys.path manipulation such as
# pygtk.require().
init-hook='import sys; sys.path.append("src")'

# Files or directories to be skipped. They should be base names, not paths.
ignore=CVS,.git,__pycache__,.pytest_cache,venv,.venv

# Files or directories matching the regex patterns are skipped. The regex
# matches against base names, not paths.
ignore-patterns=

# Use multiple processes to speed up Pylint. Specifying 0 will auto-detect the
# number of processors available to use.
jobs=0

# Pickle collected data for later comparisons.
persistent=yes

# Specify a score threshold to be exceeded before program exits with error.
fail-under=7.0

[MESSAGES CONTROL]
# Disable specific messages
disable=
    # Korean variable names and comments are intentional
    invalid-name,
    non-ascii-name,
    # Allow TODO comments
    fixme,
    # Disable import order checking (handled by isort if needed)
    wrong-import-order,
    wrong-import-position,
    # Allow short variable names in specific contexts
    too-few-public-methods,
    # Disable docstring requirements for now
    missing-module-docstring,
    missing-class-docstring,
    missing-function-docstring,
    # Allow broad exception catching in RPA context
    broad-exception-caught,
    # Allow unused variables with _ prefix
    unused-variable

[REPORTS]
# Set the output format. Available formats are text, parseable, colorized, json
# and msvs (visual studio). You can also give a reporter class, e.g.
# mypackage.mymodule.MyReporterClass.
output-format=text

# Tells whether to display a full report or only the messages.
reports=no

# Python expression which should return a score less than or equal to 10.
evaluation=10.0 - ((float(5 * error + warning + refactor + convention) / statement) * 10)

[REFACTORING]
# Maximum number of nested blocks for function / method body
max-nested-blocks=5

[BASIC]
# Good variable names which should always be accepted, separated by a comma.
good-names=i,j,k,ex,Run,_,id,db,ui,ok,df,x,y

# Bad variable names which should always be refused, separated by a comma.
bad-names=foo,bar,baz,toto,tutu,tata

# Regular expression matching correct function names
function-rgx=[a-z_][a-z0-9_]{2,30}$|[가-힣_][가-힣a-z0-9_]{2,30}$

# Regular expression matching correct variable names
variable-rgx=[a-z_][a-z0-9_]{2,30}$|[가-힣_][가-힣a-z0-9_]{2,30}$

# Regular expression matching correct constant names
const-rgx=(([A-Z_][A-Z0-9_]*)|(__.*__))$|[A-Z가-힣_][A-Z가-힣0-9_]*$

# Regular expression matching correct attribute names
attr-rgx=[a-z_][a-z0-9_]{2,30}$|[가-힣_][가-힣a-z0-9_]{2,30}$

# Regular expression matching correct argument names
argument-rgx=[a-z_][a-z0-9_]{2,30}$|[가-힣_][가-힣a-z0-9_]{2,30}$

# Regular expression matching correct class names
class-rgx=[A-Z_][a-zA-Z0-9]+$|[A-Z가-힣_][A-Z가-힣a-zA-Z0-9]+$

# Regular expression matching correct module names
module-rgx=(([a-z_][a-z0-9_]*)|([A-Z][a-zA-Z0-9]+))$|[가-힣_][가-힣a-z0-9_]*$

[FORMAT]
# Maximum number of characters on a single line.
max-line-length=100

# Maximum number of lines in a module.
max-module-lines=1000

# String used as indentation unit. This is usually "    " (4 spaces) or "\t" (1 tab).
indent-string='    '

[SIMILARITIES]
# Minimum lines number of a similarity.
min-similarity-lines=4

# Ignore comments when computing similarities.
ignore-comments=yes

# Ignore docstrings when computing similarities.
ignore-docstrings=yes

# Ignore imports when computing similarities.
ignore-imports=no

[DESIGN]
# Maximum number of arguments for function / method.
max-args=7

# Maximum number of locals for function / method body.
max-locals=15

# Maximum number of return / yield for function / method body.
max-returns=6

# Maximum number of branch for function / method body.
max-branches=12

# Maximum number of statements in function / method body.
max-statements=50

# Maximum number of parents for a class (see: http://stackoverflow.com/questions/6976577/).
max-parents=7

# Maximum number of attributes for class (see: http://stackoverflow.com/questions/6976577/).
max-attributes=7

# Minimum number of public methods for a class (see: http://stackoverflow.com/questions/6976577/).
min-public-methods=2

# Maximum number of public methods for a class (see: http://stackoverflow.com/questions/6976577/).
max-public-methods=20